# Afar_C repository line-ending policy (UTF-8 no-BOM + LF)
* text=auto eol=lf

*.c text eol=lf
*.h text eol=lf
*.m text eol=lf
*.mm text eol=lf
*.mk text eol=lf
Makefile text eol=lf
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.plist text eol=lf
*.xcprivacy text eol=lf
*.sh text eol=lf
.clang-format text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.icns binary
*.der binary
*.bin binary
